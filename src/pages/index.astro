---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Label from '@/components/home/Label.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import VisitCounter from '@/components/counter/VisitCounter.astro'
import config from '@/site-config'

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='home-page relative flex w-full flex-col items-center'>
    <div class='home-decoration' aria-hidden='true'>
      <span class='home-decoration-orb home-decoration-orb--one'></span>
      <span class='home-decoration-orb home-decoration-orb--two'></span>
      <span class='home-decoration-grid'></span>
    </div>

    <section class='home-hero animate mb-14 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='home-avatar-wrap'>
        <Image
          src={images[imagePath]()}
          alt={config.logo.alt || 'Profile'}
          class='home-avatar'
          loading='eager'
          fetchpriority='high'
        />
      </div>

      <div class='home-hero-copy flex flex-col items-center gap-y-4'>
        <h1 class='home-name text-4xl font-semibold sm:text-5xl'>{config.author}</h1>
        <div class='home-meta flex flex-wrap justify-center gap-x-6 gap-y-3'>
          <Label class='home-meta-item' title='Beijing, China' titleKey='home.location'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            class='home-meta-item'
            title='Source code'
            titleKey='home.source'
            as='a'
            href='https://github.com/cworld1/astro-theme-pure'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

    </section>

    <div id='content' class='home-content animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section class='home-section home-focus-section' title='CS Undergraduate' i18n='home.section.undergrad'>
        <Button class='home-cta w-fit self-end' href='/about' variant='ahead'>
          <span data-i18n='home.more.about'>More about me</span>
        </Button>
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section class='home-section' title='Posts' i18n='home.section.posts'>
            <ul class='home-post-list'>
              {allPostsByDate.map((p) => <PostPreview post={p} class='home-post-item' />)}
            </ul>
            <Button class='home-cta w-fit self-end' href='/blog' variant='ahead'>
              <span data-i18n='home.more.posts'>More posts</span>
            </Button>
          </Section>
        )
      }

      {
        /* <Section title='Experience'>
      <Card
        heading='Lorem Ipsum'
        subheading='Sit amet consectetur'
        date='Dec 2022 - Nov 2023'
        imagePath='/src/assets/about-astro.png'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
      >
        <ul class='ms-4 list-disc text-muted-foreground'>
          <li>
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Dolore debitis recusandae, ut
            molestiae laboriosam pariatur!

            <li>Lorem ipsum dolor sit amet consectetur adipisicing elit. Molestiae, pariatur!</li>
          </li>
        </ul>
      </Card>
      <Card
        heading='Lorem Ipsum'
        subheading='Sit amet consectetur'
        date='Dec 2022 - Nov 2023'
        imagePath='/src/assets/about-astro.png'
        altText='Lorem, ipsum dolor sit'
        imageClass='h-12 w-auto md:-start-16'
      />
    </Section> */
      }
      <Section class='home-section' title='Education' i18n='home.section.education'>
        <div class='home-education-list'>
          <Card
            class='home-education-card'
            heading='B.S. Computer Science and Technology'
            subheading='Yuanpei College, Peking University, Beijing, China'
            date='2025 - Present'
          />
          <Card
            class='home-education-card'
            heading='B.Phil Logic (Double Major)'
            subheading='Department of Philosophy, Peking University, Beijing, China'
            date='2026 - Present'
          />
          <Card
            class='home-education-card'
            heading='The High School Affiliated to Renmin University of China'
            subheading='Beijing, China'
            date='2019 - 2025'
          />
        </div>
      </Section>

      <Section class='home-section' title='Skills' i18n='home.section.skills'>
        <div class='home-skills-panel'>
          <SkillLayout title='Tech Stack' i18n='home.skills.tech' skills={['C (Familiar)', 'C++ (Exploring)', 'Python (Exploring)', 'Haskell (Beginner)']} />
        </div>
      </Section>

      <div class='home-counter-shell'>
        <span class='home-counter-dot' aria-hidden='true'></span>
        <VisitCounter sitePV class='home-counter' />
      </div>
    </div>
    <p data-i18n='home.quote' class='home-quote mt-12 text-center text-muted-foreground'>
      Be the change you wish to see in the world.
    </p>
  </main>
</PageLayout>
