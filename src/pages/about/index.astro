---
import { Button, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'contact-information', text: 'Contact Information' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'tech-stack', text: 'Tech Stack' },
  { depth: 2, slug: 'research-interest', text: 'Research Interest' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Coderdiao, B.S. Candidate</p>
  <p>
    Yuanpei College, Peking University
  </p>
  <p>
    Motto: Stay hungry, Stay foolish.
  </p>
  <Button title='GitHub' class='w-fit' href='https://github.com/CDD-2333' variant='ahead' />

  {/* contact-information */}
  <h2 id='contact-information'>Contact Information</h2>
  <ul>
    <li><strong>Name:</strong> Coderdiao, B.S. Candidate</li>
    <li><strong>Institution:</strong> Yuanpei College, Peking University</li>
    <li><strong>Address:</strong> No.5 Yiheyuan Rd., Haidian District, Beijing, China</li>
    <li><strong>Email:</strong> coderdiaocdd@163.com</li>
    <li><strong>Postal Code:</strong> 100871</li>
  </ul>

  {/* education */}
  <h2 id='education'>Education</h2>
  <Timeline
    events={[
      {
        date: '2019–2025',
        content: '<strong>The High School Affiliated to Renmin University of China</strong>, Beijing, China'
      },
      {
        date: '2025–Present',
        content: '<strong>Bachelor of Science in Computer Science and Technology</strong>, Yuanpei College, Peking University, Beijing, China'
      },
      {
        date: '2026–Present',
        content: '<strong>Bachelor of Philosophy in Logic (Double Major)</strong>, Department of Philosophy, Peking University, Beijing, China'
      }
    ]}
  />

  {/* tech-stack */}
  <h2 id='tech-stack'>Tech Stack</h2>
  <p>
    <strong>C</strong> (Familiar) | <strong>C++</strong> (Exploring) | <strong>Python</strong> (Exploring) | <strong>Haskell</strong> (Beginner)
  </p>

  {/* research-interest */}
  <h2 id='research-interest'>Research Interest</h2>
  <p>Exploring...</p>
  <p><strong>Research Papers:</strong> To be filled...</p>

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <Timeline
    events={[
      {
        date: '2026-07',
        content:
          'Website migrated from Hexo to <a href="https://astro.build/" target="_blank">Astro</a> with <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a>'
      }
    ]}
  />
  <p>
    The smooth operation and personalized customization of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>Domain: <a href='https://vercel.com/' target='_blank'>Vercel</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      CI/CD: <a href='https://vercel.com/workflow' target='_blank'>Vercel Workflow</a>
    </li>
    <li>Comment system: <a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      Visits: <a href='https://supabase.com/' target='_blank'>Supabase</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      Other statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
  </ul>
</PageLayout>
