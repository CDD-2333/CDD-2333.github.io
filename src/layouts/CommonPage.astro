---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment } from '@/components/waline'
import VisitCounter from '@/components/counter/VisitCounter.astro'
import config from '@/site-config'

interface Props {
  title: string
  headings?: MarkdownHeading[]
  view?: boolean
  comment?: boolean
  /** Optional i18n key — when set, the page title gets translated client-side. */
  titleKey?: string
}

const { title, headings, view, comment: enableComment, titleKey, ...props } = Astro.props
const walineEnabled = config.integ.waline.enable
const path = Astro.url.pathname
---

<PageLayout meta={{ title }} {...props}>
  {headings?.length && <TOC headings={headings} slot='sidebar' />}

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl' data-i18n={titleKey}>{title}</h1>
    {(view || (enableComment && walineEnabled)) && (
      <div class='italic text-sm text-muted-foreground'>
        {view && <VisitCounter pageView class='me-2' />}
        {enableComment && walineEnabled && (
          <>
            {view && <span class='mx-1'>|</span>}
            <a href='#waline'>
              <span class='waline-comment-count' data-path={path} />{' '}
              <span data-i18n='counter.comments'>comments</span>
            </a>
          </>
        )}
      </div>
    )}
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom'>
    {enableComment && <Comment class='mt-3 sm:mt-6' />}
  </slot>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
