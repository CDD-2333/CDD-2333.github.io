---
import { Button } from 'astro-pure/user'

type Props = {
  title: string
  skills: string[]
  /** Optional i18n key — when set, the title gets translated client-side. */
  i18n?: string
}

const { title, skills, i18n } = Astro.props
---

<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
  <h3 class='w-1/5 font-medium' data-i18n={i18n}>{title}</h3>
  <div class='flex flex-row flex-wrap gap-x-4 gap-y-2 md:w-4/5'>
    {skills.map((skill: string) => <Button as='button' title={skill} variant='pill' />)}
  </div>
</div>
