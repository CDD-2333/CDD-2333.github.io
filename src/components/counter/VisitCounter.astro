---
interface Props {
  /** Show per-page view count */
  pageView?: boolean
  /** Show site-wide total views */
  sitePV?: boolean
  /** Show site-wide unique visitors */
  siteUV?: boolean
  class?: string
}

const { pageView, sitePV, siteUV, class: className } = Astro.props
---

{
  pageView && <span class={className}>Views: <span id='busuanzi_value_page_pv' /></span>
}
{
  sitePV && <span class={className}>Site Views: <span id='busuanzi_value_site_pv' /></span>
}
{
  siteUV && <span class={className}>Visitors: <span id='busuanzi_value_site_uv' /></span>
}

<script is:inline data-astro-rerun>
  (function fetchVercount() {
    const API = 'https://events.vercount.one/api/v2/log'
    const url = window.location.href
    if (!url.startsWith('http')) return

    const host = window.location.host || 'unknown-host'
    const uvKey = 'vercount_uv_' + host.replace(/[^a-zA-Z0-9_-]/g, '_')
    const isNewUv = document.cookie.indexOf(uvKey + '=') === -1
    if (isNewUv) {
      document.cookie = uvKey + '=1; path=/; max-age=31536000; samesite=lax'
    }

    fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, isNewUv })
    })
      .then(function (r) { return r.json() })
      .then(function (res) {
        var data = (res && res.data) || res || {}
        var keys = ['site_pv', 'page_pv', 'site_uv']
        for (var i = 0; i < keys.length; i++) {
          var el = document.getElementById('busuanzi_value_' + keys[i])
          if (el) el.textContent = data[keys[i]] || '0'
        }
      })
      .catch(function () {
        // Counter is non-essential; fail silently
      })
  })()
</script>
