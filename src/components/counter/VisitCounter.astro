---
interface Props {
  /** Show per-page view count */
  pageView?: boolean
  /** Show site-wide total views */
  sitePV?: boolean
  /** Show site-wide unique visitors */
  siteUV?: boolean
  class?: string
}

const { pageView, sitePV, siteUV, class: className } = Astro.props
---

{
  pageView && (
    <span class={className}>
      <span data-i18n='counter.pageViews'>Views:</span>{' '}
      <span id='vercount_value_page_pv'>Loading</span>
    </span>
  )
}
{
  sitePV && (
    <span class={className}>
      <span data-i18n='counter.siteViews'>Site Views:</span>{' '}
      <span id='vercount_value_site_pv'>Loading</span>
    </span>
  )
}
{
  siteUV && (
    <span class={className}>
      <span data-i18n='counter.siteUV'>Visitors:</span>{' '}
      <span id='vercount_value_site_uv'>Loading</span>
    </span>
  )
}
